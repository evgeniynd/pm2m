HOST=127.0.0.1
PORT=3100
ADMIN_PASSWORD=replace-with-a-long-random-password
# Set to true behind an HTTPS reverse proxy
COOKIE_SECURE=false
# GitHub OAuth App Client ID with Device Flow enabled
# GITHUB_CLIENT_ID=
# Must match the user/PM2 instance that runs your applications
# PM2_HOME=/home/deploy/.pm2
